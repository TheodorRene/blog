---
import Base from '../../layouts/Base.astro';
import talks from '../../data/talks.json';
---

<Base title="talks | theodorc" description="Conference talks and presentations by theodorc">
  <h1>~/talks</h1>
  <ul class="talk-list">
    {talks.map((talk) => (
      <li class="talk-list-item">
        <div class="talk-list-heading">
          <span class="talk-list-date">{talk.date}</span>
          <span class="talk-list-title">{talk.title}</span>
        </div>
        <p class="talk-list-event">
          {talk.event}
        </p>
        <p is-="typography-block" class="talk-list-description">
          {talk.description}
        </p>
        <div class="talk-list-links">
          {talk.slidesUrl && (
            <a href={talk.slidesUrl}>[slides]</a>
          )}
          {talk.videoUrl && (
            <a href={talk.videoUrl} target="_blank" rel="noopener">[video]</a>
          )}
        </div>
      </li>
    ))}
  </ul>
</Base>
