---
import Base from '../../layouts/Base.astro';
import talks from '../../data/talks.json';
---

<Base title="talks | theodorc" description="Conference talks and presentations by theodorc">
  <h1>~/talks</h1>
  <br />
  <ul style="list-style: none; padding: 0;">
    {talks.map((talk) => (
      <li style="margin-bottom: 2lh; padding: 1ch 0;">
        <div style="display: flex; gap: 2ch; align-items: baseline;">
          <span style="color: var(--overlay1); white-space: nowrap;">{talk.date}</span>
          <span style="color: var(--green); font-weight: bold;">{talk.title}</span>
        </div>
        <p style="color: var(--subtext0); margin: 0.5lh 0; padding-left: 14ch;">
          {talk.event}
        </p>
        <p is-="typography-block" style="padding-left: 14ch;">
          {talk.description}
        </p>
        <div style="display: flex; gap: 2ch; padding-left: 14ch; margin-top: 0.5lh;">
          {talk.slidesUrl && (
            <a href={talk.slidesUrl}>[slides]</a>
          )}
          {talk.videoUrl && (
            <a href={talk.videoUrl} target="_blank" rel="noopener">[video]</a>
          )}
        </div>
      </li>
    ))}
  </ul>
</Base>
